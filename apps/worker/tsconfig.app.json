{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "dist",
		"module": "nodenext",
		"types": ["node"],
		"rootDir": "src",
		"moduleResolution": "nodenext",
		"tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo"
	},
	"include": ["src/**/*.ts"],
	"exclude": [
		"out-tsc",
		"dist",
		"jest.config.ts",
		"jest.config.cts",
		"src/**/*.spec.ts",
		"src/**/*.test.ts",
		"eslint.config.js",
		"eslint.config.cjs",
		"eslint.config.mjs"
	],
	"references": [
		{
			"path": "../../libs/platform-core/tsconfig.lib.json"
		},
		{
			"path": "../../libs/contracts/tsconfig.lib.json"
		}
	]
}
