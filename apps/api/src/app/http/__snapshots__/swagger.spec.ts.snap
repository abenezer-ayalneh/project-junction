                          "type": "array",
                        },
                        "timezone": {
                          "maxLength": 80,
                          "minLength": 1,
                          "type": "string",
                        },
                        "weekly": {
                          "items": {
                            "additionalProperties": false,
                            "properties": {
                              "breaks": {
                                "items": {
                                  "additionalProperties": false,
                                  "properties": {
                                    "endMinute": {
                                      "maximum": 1440,
                                      "minimum": 1,
                                      "type": "integer",
                                    },
                                    "startMinute": {
                                      "maximum": 1439,
                                      "minimum": 0,
                                      "type": "integer",
                                    },
                                  },
                                  "required": [
                                    "startMinute",
                                    "endMinute",
                                  ],
                                  "type": "object",
                                },
                                "maxItems": 20,
                                "type": "array",
                              },
                              "hours": {
                                "items": {
                                  "additionalProperties": false,
                                  "properties": {
                                    "endMinute": {
                                      "maximum": 1440,
                                      "minimum": 1,
                                      "type": "integer",
                                    },
                                    "startMinute": {
                                      "maximum": 1439,
                                      "minimum": 0,
                                      "type": "integer",
                                    },
                                  },
                                  "required": [
                                    "startMinute",
                                    "endMinute",
                                  ],
                                  "type": "object",
                                },
                                "maxItems": 20,
                                "type": "array",
                              },
                              "weekday": {
                                "maximum": 6,
                                "minimum": 0,
                                "type": "integer",
                              },
                            },
                            "required": [
                              "hours",
                              "breaks",
                              "weekday",
                            ],
                            "type": "object",
                          },
                          "maxItems": 7,
                          "type": "array",
                        },
                      },
                      "required": [
                        "timezone",
                        "weekly",
                        "exceptions",
                      ],
                      "type": "object",
                    },
                    "locationId": {
                      "format": "uuid",
                      "nullable": true,
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                      "type": "string",
                    },
                    "mode": {
