  "info": {
    "contact": {},
    "description": "Synthetic-runtime API for the Project Junction platform foundation. Every response declares X-API-Version: v1 and X-API-Lifecycle: active.",
    "title": "Project Junction API",
    "version": "v1",
  },
  "openapi": "3.0.0",
  "paths": {
    "/v1/access-context": {
      "get": {
        "operationId": "AppController_accessContext",
        "parameters": [
          {
            "description": "Synthetic session identifier.",
            "in": "header",
            "name": "x-junction-session",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessContextResponse",
                },
              },
            },
            "description": "",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "",
          },
        },
        "security": [
          {
            "junction-session": [],
          },
        ],
        "summary": "Derive the current scoped access context.",
        "tags": [
          "foundation",
        ],
      },
    },
    "/v1/catalog-exports/v1": {
      "get": {
        "operationId": "AppController_exportCatalog",
        "parameters": [
          {
            "in": "header",
            "name": "x-junction-session",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "description": "",
          },
        },
        "security": [
          {
            "junction-session": [],
