    "securitySchemes": {
      "junction-auth-cookie": {
        "description": "Better Auth session cookie for private staging identity.",
        "in": "cookie",
        "name": "__Secure-junction-auth.session_token",
        "type": "apiKey",
      },
    },
  },
  "info": {
    "contact": {},
    "description": "Private staging API backed by real account and provider integrations. Every response declares X-API-Version: v1 and X-API-Lifecycle: active.",
    "title": "Project Junction API",
    "version": "v1",
  },
  "openapi": "3.0.0",
  "paths": {
    "/v1/access-context": {
      "get": {
        "operationId": "AppController_accessContext",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessContextResponse",
                },
              },
            },
            "description": "",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "",
          },
        },
        "security": [
          {
            "junction-auth-cookie": [],
          },
        ],
        "summary": "Derive the current scoped access context.",
        "tags": [
          "foundation",
        ],
      },
    },
    "/v1/account/active-vendor": {
      "post": {
        "operationId": "AppController_selectActiveVendor",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActiveVendorSelection",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActiveVendorSelectionResult",
                },
              },
            },
            "description": "",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "",
          },
        },
        "security": [
          {
            "junction-auth-cookie": [],
          },
        ],
        "summary": "Select an eligible Vendor Owner membership after recent MFA, or return to the Customer scope.",
        "tags": [
          "foundation",
        ],
      },
    },
    "/v1/account/vendor-memberships": {
      "get": {
        "operationId": "AppController_listOwnerMemberships",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VendorMemberships",
                },
              },
            },
            "description": "",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError",
                },
              },
            },
            "description": "",
          },
        },
        "security": [
          {
            "junction-auth-cookie": [],
          },
        ],
        "summary": "List the signed-in adult account’s eligible Vendor Owner memberships.",
        "tags": [
          "foundation",
        ],
      },
    },
    "/v1/catalog-exports/v1": {
      "get": {
        "operationId": "AppController_exportCatalog",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
          },
        },
        "security": [
          {
            "junction-auth-cookie": [],
          },
        ],
        "summary": "Export only the active Vendor catalog in the versioned CSV template.",
        "tags": [
          "foundation",
        ],
      },
    },
