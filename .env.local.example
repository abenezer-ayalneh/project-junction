# Project Junction local development only. Copy to ignored .env, then replace the Better Auth and Google OAuth placeholders.
# Use only loopback services and a dedicated local Google OAuth client; never put staging or production credentials here.

# Runtime and local ports
JUNCTION_RUNTIME_MODE=local
FOUNDATION_STORAGE=postgresql
API_BIND_ADDRESS=127.0.0.1
API_PORT=3001
WEB_PORT=3000
JUNCTION_POSTGRES_PORT=55432

# API and browser origins
JUNCTION_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_JUNCTION_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_JUNCTION_RUNTIME_MODE=local
CORS_ALLOWED_ORIGINS=http://localhost:3000
REALTIME_REDIS_FANOUT=enabled

# PostgreSQL and Redis
DATABASE_URL=postgresql://junction:junction@127.0.0.1:55432/junction?schema=public
REDIS_URL=redis://127.0.0.1:6379

# Better Auth and Google OAuth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-local-secret-at-least-32-characters-long
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Mailpit SMTP
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
LOCAL_MAIL_FROM_EMAIL="Project Junction <no-reply@junction.localhost>"

# Search, throttling, and logs
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_MASTER_KEY=synthetic-local-key-only
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOG_LEVEL=info

# Media storage and scanning
MEDIA_S3_ENDPOINT=http://127.0.0.1:59000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=junction-media-local
MEDIA_S3_ACCESS_KEY_ID=junction-local
MEDIA_S3_SECRET_ACCESS_KEY=junction-local-secret
MEDIA_CLAMD_HOST=127.0.0.1
MEDIA_CLAMD_PORT=13310
