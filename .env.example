# Application runtime
JUNCTION_RUNTIME_MODE=synthetic
API_PORT=3001
WEB_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOG_LEVEL=info
# Required only for local POST /v1/synthetic/accounts fixture provisioning.
SYNTHETIC_ACCOUNT_PROVISIONING_SECRET=replace-with-local-secret

# Service connections
DATABASE_URL=postgresql://junction:junction@127.0.0.1:55432/junction?schema=public
REDIS_URL=redis://127.0.0.1:6379
REALTIME_REDIS_FANOUT=disabled
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_MASTER_KEY=synthetic-local-key-only

# Storage configuration
# Durable synthetic mode; seed sessions explicitly for local testing.
FOUNDATION_STORAGE=postgresql
JUNCTION_POSTGRES_PORT=55432
