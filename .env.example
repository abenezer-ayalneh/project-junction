# Application runtime
JUNCTION_RUNTIME_MODE=synthetic
API_PORT=3001
WEB_PORT=3000
# Server-side URL used by the web discovery pages.
JUNCTION_API_URL=http://127.0.0.1:3001/v1
NEXT_PUBLIC_JUNCTION_API_URL=http://127.0.0.1:3001/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOG_LEVEL=info
# Required only for local POST /v1/synthetic/accounts fixture provisioning.
SYNTHETIC_ACCOUNT_PROVISIONING_SECRET=replace-with-local-secret

# Service connections
DATABASE_URL=postgresql://junction:junction@127.0.0.1:55432/junction?schema=public
REDIS_URL=redis://127.0.0.1:6379
REALTIME_REDIS_FANOUT=disabled
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_MASTER_KEY=synthetic-local-key-only

# Storage configuration
# PostgreSQL is required for API and worker processes.
FOUNDATION_STORAGE=postgresql
JUNCTION_POSTGRES_PORT=55432
# Local S3-compatible quarantine store; replace with separate R2 credentials per target environment.
MEDIA_S3_ENDPOINT=http://127.0.0.1:59000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=junction-media-local
MEDIA_S3_ACCESS_KEY_ID=junction-local
MEDIA_S3_SECRET_ACCESS_KEY=junction-local-secret
MEDIA_CLAMD_HOST=127.0.0.1
MEDIA_CLAMD_PORT=13310

# Private staging identity (set these through staging secrets, not the local fixture env)
# JUNCTION_RUNTIME_MODE=staging
# NEXT_PUBLIC_JUNCTION_RUNTIME_MODE=staging
# NEXT_PUBLIC_JUNCTION_API_URL=/v1
# BETTER_AUTH_URL=https://staging.example.com
# BETTER_AUTH_SECRET=<random secret of at least 32 characters>
# RESEND_API_KEY=<staging Resend API key>
# RESEND_FROM_EMAIL=Project Junction <verify@staging.example.com>
# SUMSUB_APP_TOKEN=<sandbox app token>
# SUMSUB_SECRET_KEY=<sandbox API signing secret>
# SUMSUB_WEBHOOK_SECRET=<separate sandbox webhook digest secret>
# SUMSUB_AGE_LEVEL=<configured sandbox level enforcing age 18 or older>
# SUMSUB_AGE_18_LEVEL_CONFIRMED=true  # Set only after verifying the sandbox level's age rule and webhook/API permissions.
