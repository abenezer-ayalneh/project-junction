# Private staging configuration shape. Copy only into a protected host environment.
# Values required below are deliberately unset; provision them from staging-only secrets.
# The synthetic Compose/test fixture is .env.integration.example.

JUNCTION_RUNTIME_MODE=staging
FOUNDATION_STORAGE=postgresql
NEXT_PUBLIC_JUNCTION_RUNTIME_MODE=staging
NEXT_PUBLIC_JUNCTION_API_URL=/v1
REALTIME_REDIS_FANOUT=enabled
API_PORT=3001
WEB_PORT=3000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOG_LEVEL=info

# Set these to the isolated staging PostgreSQL, Redis, and private API upstream.
# DATABASE_URL=
# REDIS_URL=
# JUNCTION_API_URL=

# Set BETTER_AUTH_URL to the actual staging HTTPS origin. Staging CORS derives from it.
# BETTER_AUTH_URL=
# BETTER_AUTH_SECRET=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Sumsub sandbox credentials and an age-18 verification level are required.
# SUMSUB_APP_TOKEN=
# SUMSUB_SECRET_KEY=
# SUMSUB_WEBHOOK_SECRET=
# SUMSUB_AGE_LEVEL=
# Keep this unset until the sandbox level and signed callback/reconciliation pass.
# SUMSUB_AGE_18_LEVEL_CONFIRMED=true

# Use a separate HTTPS object-store endpoint and staging-only bucket/credentials.
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_REGION=
# MEDIA_S3_BUCKET=
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_CLAMD_HOST=
# MEDIA_CLAMD_PORT=

# Host-side Caddy values; keep the hash and all secrets out of this repository.
# STAGING_HOSTNAME=
# STAGING_BASIC_AUTH_USER=
# STAGING_BASIC_AUTH_HASH=
# STAGING_API_UPSTREAM=
# STAGING_WEB_UPSTREAM=
