# Application runtime
JUNCTION_RUNTIME_MODE=synthetic
API_PORT=3001
WEB_PORT=3000
# Server-side URL used by the web discovery pages.
JUNCTION_API_URL=http://127.0.0.1:3001/v1
NEXT_PUBLIC_JUNCTION_API_URL=http://127.0.0.1:3001/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOG_LEVEL=info
# Required only for local POST /v1/synthetic/accounts fixture provisioning.
SYNTHETIC_ACCOUNT_PROVISIONING_SECRET=replace-with-local-secret

# Service connections
DATABASE_URL=postgresql://junction:junction@127.0.0.1:55432/junction?schema=public
REDIS_URL=redis://127.0.0.1:6379
REALTIME_REDIS_FANOUT=disabled
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_MASTER_KEY=synthetic-local-key-only

# Storage configuration
# Durable synthetic mode; seed sessions explicitly for local testing.
FOUNDATION_STORAGE=postgresql
JUNCTION_POSTGRES_PORT=55432
# Local S3-compatible quarantine store; replace with separate R2 credentials per target environment.
MEDIA_S3_ENDPOINT=http://127.0.0.1:59000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=junction-media-local
MEDIA_S3_ACCESS_KEY_ID=junction-local
MEDIA_S3_SECRET_ACCESS_KEY=junction-local-secret
MEDIA_CLAMD_HOST=127.0.0.1
MEDIA_CLAMD_PORT=13310
