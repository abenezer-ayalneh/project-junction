# Synthetic local backup-controller settings. Source .env.integration.example first.
# The controller is opt-in; no background process starts with ordinary development.
MEDIA_BACKUP_ENDPOINT=http://127.0.0.1:59000
MEDIA_BACKUP_REGION=us-east-1
MEDIA_BACKUP_ACCESS_KEY_ID=junction-local
MEDIA_BACKUP_SECRET_ACCESS_KEY=junction-local-secret
MEDIA_BACKUP_BUCKET=junction-media-backups-local
MEDIA_BACKUP_CATALOG_BUCKET=junction-backup-catalog-local
MEDIA_BACKUP_POLICY_FILE=ops/local/media-backup-policy.example.json
# Set to a private 0600 file outside the repository containing 64 hex characters.
MEDIA_BACKUP_KEY_FILE=
# Import/hold/release/restore inputs are set explicitly when used.
# MEDIA_BACKUP_ARCHIVE_FILE=
# MEDIA_BACKUP_ARCHIVE_CREATED_AT=2026-10-09T00:00:00Z
# MEDIA_BACKUP_GENERATION_ID=
# MEDIA_BACKUP_HOLD_REASON=
# MEDIA_RECOVERY_ISOLATED=1
# MEDIA_RECOVERY_ENDPOINT=http://127.0.0.1:59000
# MEDIA_RECOVERY_REGION=us-east-1
# MEDIA_RECOVERY_ACCESS_KEY_ID=junction-local
# MEDIA_RECOVERY_SECRET_ACCESS_KEY=junction-local-secret
# MEDIA_RECOVERY_BUCKET=junction-media-recovery-local
