			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "Staging verifies production-relevant behavior with synthetic data but remains private and cannot substitute for the public demo or accept real Customer, Vendor, KYB, or payment data."
		},
		{
