		{
			"id": "adr_adr_0001_separate_parked_venture_dec_001",
			"label": "Keep Project Junction Separate from the Parked Venture",
			"file_type": "rationale",
			"source_file": "docs/adr/ADR-0001-SEPARATE-PARKED-VENTURE.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "Separating the earlier social-checkout concept avoids misleading readiness claims even though it may require duplicated research later."
		},
		{
			"id": "adr_adr_0002_portfolio_first_evidence_posture_dec_003_004_139",
			"label": "Portfolio-First Evidence-Gated Claims",
			"file_type": "rationale",
			"source_file": "docs/adr/ADR-0002-PORTFOLIO-FIRST-EVIDENCE-POSTURE.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "Public claims need test, recovery, and provider evidence and must qualify sandbox or synthetic behavior to avoid an untrustworthy demo."
		},
		{
			"id": "adr_adr_0003_modular_monolith_and_worker_dec_080_082",
			"label": "Nx Modular Monolith with a Worker",
			"file_type": "rationale",
			"source_file": "docs/adr/ADR-0003-MODULAR-MONOLITH-AND-WORKER.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "One authoritative application/API boundary and a separate background worker preserve explicit context boundaries while avoiding premature distributed-service complexity."
		},
		{
			"id": "adr_adr_0004_ordering_and_booking_separation_dec_019_082_157_160",
			"label": "Separate Ordering from Booking",
			"file_type": "rationale",
			"source_file": "docs/adr/ADR-0004-ORDERING-AND-BOOKING-SEPARATION.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "Goods fulfillment and staff-allocated appointments have distinct states, timeouts, evidence, cancellation, and earnings-release rules, so they remain separate aggregates."
		},
		{
			"id": "adr_adr_0005_one_next_client_authoritative_nest_api_dec_079_119_127",
			"label": "One Adaptive Next Client with Authoritative Nest APIs",
			"file_type": "rationale",
			"source_file": "docs/adr/ADR-0005-ONE-NEXT-CLIENT-AUTHORITATIVE-NEST-API.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "A responsive installable Next PWA and authoritative Nest APIs avoid duplicate client business logic while preserving reusable API contracts."
		},
		{
			"id": "adr_adr_0006_typed_access_context_dec_010_071_129",
			"label": "Typed Server-Derived Access Context",
			"file_type": "rationale",
			"source_file": "docs/adr/ADR-0006-TYPED-ACCESS-CONTEXT.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "Server-derived access from session and scoped membership supports auditable multi-Vendor and Location scope while preventing broad client role checks and cross-tenant leakage."
		},
		{
			"id": "adr_adr_0007_atomic_mixed_checkout_and_holds_dec_018_019_022_023_125_157_158_182",
			"label": "Atomic Mixed Checkout with Expiring Holds",
			"file_type": "rationale",
			"source_file": "docs/adr/ADR-0007-ATOMIC-MIXED-CHECKOUT-AND-HOLDS.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "Idempotent stock and Staff holds allow one Purchase to coordinate multi-Vendor goods and booking intents without oversell or double booking."
		},
		{
			"id": "adr_adr_0008_provider_neutral_sandbox_payments_dec_025_075_077_103_154_155",
			"label": "Provider-Neutral Payments with Stripe Sandbox Role Split",
			"file_type": "rationale",
			"source_file": "docs/adr/ADR-0008-PROVIDER-NEUTRAL-SANDBOX-PAYMENTS.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "A provider-neutral interface, Stripe sandbox role model, and local fake adapters demonstrate workflow depth without claiming a validated Ethiopian commercial arrangement."
		},
		{
			"id": "adr_adr_0009_immutable_double_entry_ledger_dec_038_140_187_188",
			"label": "Immutable Double-Entry Ledger and Delayed Earnings",
			"file_type": "rationale",
			"source_file": "docs/adr/ADR-0009-IMMUTABLE-DOUBLE-ENTRY-LEDGER.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "Balanced immutable postings with compensating reversals and delayed Vendor earnings keep reconciliation and dispute history explainable."
		},
		{
			"id": "adr_adr_0010_postgres_postgis_prisma_audited_sql_dec_079_084_085_095_121_128",
			"label": "PostgreSQL/PostGIS with Prisma and Audited SQL",
			"file_type": "rationale",
			"source_file": "docs/adr/ADR-0010-POSTGRES-POSTGIS-PRISMA-AUDITED-SQL.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "PostgreSQL/PostGIS is the transactional and geospatial source of truth; Prisma is general access, while audited SQL controls correctness-critical geospatial, locking, and ledger queries."
		},
		{
			"id": "adr_adr_0011_outbox_rebuildable_projections_dec_081_086_087_123_124",
			"label": "Transactional Outbox and Rebuildable Projections",
			"file_type": "rationale",
			"source_file": "docs/adr/ADR-0011-OUTBOX-REBUILDABLE-PROJECTIONS.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "Transactional domain changes and worker-driven rebuildable projections allow safe recovery without treating queues or search as commerce truth."
		},
		{
			"id": "adr_adr_0012_synthetic_public_demo_isolation_dec_107_109_139_172_177_178",
			"label": "Isolated Synthetic Public Demo",
			"file_type": "rationale",
			"source_file": "docs/adr/ADR-0012-SYNTHETIC-PUBLIC-DEMO-ISOLATION.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "A no-signup, quota-bound synthetic workspace that expires and is purged lets reviewers see roles without exposing real users, Vendors, money, or credentials."
		},
		{
			"id": "adr_adr_0013_media_quarantine_dec_047_088_175_176",
			"label": "Quarantined Versioned Media Pipeline",
			"file_type": "rationale",
			"source_file": "docs/adr/ADR-0013-MEDIA-QUARANTINE.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "Quarantine, validation, processing, and versioned promotion of untrusted media protect presentation and support caption and no-speech accessibility enforcement."
		},
		{
			"id": "adr_adr_0014_vps_staging_portfolio_recovery_model_dec_089_097_110_111",
			"label": "Separate Staging and Portfolio Production on a Hardened VPS Target",
			"file_type": "rationale",
			"source_file": "docs/adr/ADR-0014-VPS-STAGING-PORTFOLIO-RECOVERY-MODEL.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "Separate staging and portfolio-production environments, backups, and recovery testing favor cost discipline and operational learning without conflating them with a future commercial environment."
		},
		{
			"id": "adr_adr_0015_asvs_l2_security_target_dec_153",
			"label": "OWASP ASVS 5.0 Level 2 Security Target",
			"file_type": "rationale",
			"source_file": "docs/adr/ADR-0015-ASVS-L2-SECURITY-TARGET.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "ASVS Level 2 provides a concrete review language without overstating certification; applicability, evidence, and exceptions remain release-specific."
		},
		{
			"id": "adr_adr_0016_public_repository_no_open_source_license_dec_112_113",
			"label": "Public Repository without an Open-Source License",
			"file_type": "rationale",
			"source_file": "docs/adr/ADR-0016-PUBLIC-REPOSITORY-NO-OPEN-SOURCE-LICENSE.md",
			"source_location": null,
			"source_url": null,
			"captured_at": null,
			"author": null,
			"contributor": null,
			"rationale": "The intended portfolio repository remains reviewable while retaining copyright and reuse control during the portfolio phase."
		}
	],
