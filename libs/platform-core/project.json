{
	"name": "platform-core",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "libs/platform-core/src",
	"projectType": "library",
	"tags": ["type:domain", "scope:platform"],
	"// targets": "to see all targets run: nx show project platform-core --web",
	"targets": {
		"test-local-scopes": {
			"executor": "nx:run-commands",
			"cache": false,
			"options": {
				"command": "node --env-file=.env tools/check-local-owner-scopes.mjs"
			},
			"dependsOn": ["build"]
		},
		"test-integration": {
			"executor": "nx:run-commands",
			"cache": false,
			"options": {
				"command": "node tools/run-integration.mjs"
			},
			"dependsOn": [
				"build",
				{
					"projects": ["api", "worker"],
					"target": "build"
				}
			]
		},
		"generate-client": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": ["{workspaceRoot}/prisma/schema.prisma", "{workspaceRoot}/prisma.config.ts"],
			"outputs": ["{projectRoot}/generated/prisma"],
			"options": {
				"command": "node tools/generate-prisma.mjs"
			}
		},
		"build": {
			"dependsOn": ["generate-client", "^build"]
		},
		"typecheck": {
			"dependsOn": ["generate-client"]
		},
		"media-backup-rotate": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["build"],
			"options": {
				"command": "node tools/reconcile-media-backups.mjs rotate"
			}
		},
		"media-restore-reconcile": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["build"],
			"options": {
				"command": "node tools/reconcile-media-backups.mjs restore"
			}
		},
		"test-media-restore": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["build"],
			"options": {
				"command": "MEDIA_RESTORE_REHEARSAL=1 node tools/check-restore-rehearsal.mjs"
			}
		},
		"media-backup-status": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["build"],
			"options": { "command": "node tools/media-backup-controller.mjs status" }
		},
		"media-backup-run": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["build"],
			"options": { "command": "node tools/media-backup-controller.mjs run" }
		},
		"media-backup-watch": {
			"executor": "nx:run-commands",
			"cache": false,
			"continuous": true,
			"dependsOn": ["build"],
			"options": { "command": "node tools/media-backup-controller.mjs watch" }
		},
		"media-backup-import": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["build"],
			"options": { "command": "node tools/media-backup-controller.mjs import" }
		},
		"media-backup-hold": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["build"],
			"options": { "command": "node tools/media-backup-controller.mjs hold" }
		},
		"media-backup-release": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["build"],
			"options": { "command": "node tools/media-backup-controller.mjs release" }
		},
		"media-backup-restore": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["build"],
			"options": { "command": "node tools/media-backup-controller.mjs restore" }
		}
	}
}
