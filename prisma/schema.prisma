generator client {
  provider = "prisma-client-js"
  output   = "../libs/platform-core/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  bookingHolds BookingHold[]
  goodsCancellationGrants      GoodsCancellationGrant[]
  goodsPurchases               GoodsPurchase[]
  goodsQuotes                  GoodsQuote[]
  id                           String                        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email                        String                        @unique
  adultVerificationState       String                        @default("unverified") @map("adult_verification_state")
  verifiedAt                   DateTime?                     @map("verified_at") @db.Timestamptz(6)
  createdAt                    DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  sessions                     Session[]
  memberships                  VendorMembership[]
  staffProfiles                Staff[]
  savedListings                SavedListing[]
  followedVendors              VendorFollow[]
  savedSearches                SavedSearch[]
  discoveryPreference          DiscoveryPreference?
  platformReviewerGrant        PlatformReviewerGrant?
  identityVerificationSessions IdentityVerificationSession[]

  @@map("users")
}

model Workspace {
  bookingHolds BookingHold[]
  goodsCancellationGrants      GoodsCancellationGrant[]
  goodsPurchases               GoodsPurchase[]
  goodsOrders                  GoodsVendorOrder[]
  goodsQuotes                  GoodsQuote[]
  goodsHoldLines               GoodsHoldLine[]
  id                           String                        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind                         String                        @default("real")
  createdAt                    DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  vendors                      Vendor[]
  sessions                     Session[]
  identityVerificationSessions IdentityVerificationSession[]

  @@map("workspaces")
}

model PlatformReviewerGrant {
  userId    String    @id @map("user_id") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  grantedBy String    @map("granted_by")
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("platform_reviewer_grants")
}

model Session {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  mfaVerifiedAt  DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  recentAuthAt   DateTime? @map("recent_auth_at") @db.Timestamptz(6)
  activeVendorId String?   @map("active_vendor_id") @db.Uuid
  activeRole     String?   @map("active_role")
  realtimeCursor String?   @map("realtime_cursor") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  activeVendor   Vendor?   @relation("SessionActiveVendor", fields: [activeVendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspaceId, expiresAt])
  @@map("sessions")
}

model Vendor {
  bookingHolds BookingHold[]
  goodsOrders           GoodsVendorOrder[]
  goodsHoldLines        GoodsHoldLine[]
  id                    String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId           String             @map("workspace_id") @db.Uuid
  publicSlug            String?            @unique @map("public_slug")
  publishedAt           DateTime?          @map("published_at") @db.Timestamptz(6)
  applicationState      String             @default("pending") @map("application_state")
  applicationReviewedAt DateTime?          @map("application_reviewed_at") @db.Timestamptz(6)
  displayName           String?            @map("display_name")
  description           String?
  logoMediaId           String?            @map("logo_media_id") @db.Uuid
  coverMediaId          String?            @map("cover_media_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace             Workspace          @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locations             Location[]
  memberships           VendorMembership[]
  staff                 Staff[]
  activeSessions        Session[]          @relation("SessionActiveVendor")
  listings              Listing[]
  importJobs            CatalogImportJob[]
  followers             VendorFollow[]
  logoMedia             MediaAsset?        @relation("VendorLogoMedia", fields: [logoMediaId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  coverMedia            MediaAsset?        @relation("VendorCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([workspaceId])
  @@index([publishedAt, id])
  @@map("vendors")
}

model VendorFollow {
  userId    String   @map("user_id") @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, vendorId])
  @@index([vendorId, createdAt])
  @@map("vendor_follows")
}

model SavedListing {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, listingId])
  @@map("saved_listings")
}

model SavedSearch {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  kind        String?
  category    String?
  query       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, workspaceId])
  @@map("saved_searches")
}

model DiscoveryPreference {
  userId               String   @id @map("user_id") @db.Uuid
  workspaceId          String   @map("workspace_id") @db.Uuid
  personalizationOptIn Boolean  @default(false) @map("personalization_opt_in")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("discovery_preferences")
}

model Listing {
  bookingPolicy String @default("standard") @map("booking_policy")
  schedulingRules Json? @map("scheduling_rules")
  schedulingRulesVersion Int @default(0) @map("scheduling_rules_version")
  /// Versioned fixed commercial definitions and Vendor-validated Staff qualifications; no allocation state.
  serviceConfiguration Json? @map("service_configuration")
  serviceConfigurationVersion Int @default(0) @map("service_configuration_version")
  goodsHoldLines     GoodsHoldLine[]
  id                 String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  vendorId           String              @map("vendor_id") @db.Uuid
  kind               String
  category           String
  title              String
  description        String
  priceCents         Int?                @map("price_cents")
  durationMinutes    Int?                @map("duration_minutes")
  state              String              @default("draft")
  version            Int                 @default(1)
  publishedAt        DateTime?           @map("published_at") @db.Timestamptz(6)
  unpublishedAt      DateTime?           @map("unpublished_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  vendor             Vendor              @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revisions          ListingRevision[]
  media              MediaAsset[]
  searchDocument     SearchDocument?
  savedBy            SavedListing[]
  variants           ListingVariant[]
  inventoryMovements InventoryMovement[]

  @@index([vendorId, state])
  @@index([kind, state, publishedAt])
  @@map("listings")
}

model ListingVariant {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  listingId  String   @map("listing_id") @db.Uuid
  sku        String
  label      String
  priceCents Int      @map("price_cents")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([listingId, sku])
  @@index([listingId])
  @@map("listing_variants")
}

model ListingRevision {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  listingId  String   @map("listing_id") @db.Uuid
  version    Int
  state      String
  risk       String
  snapshot   Json
  reviewedBy String?  @map("reviewed_by") @db.Uuid
  reviewNote String?  @map("review_note")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([listingId, version])
  @@index([state, createdAt])
  @@map("listing_revisions")
}

model MediaAsset {
  id                      String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  listingId               String    @map("listing_id") @db.Uuid
  uploaderId              String?   @map("uploader_id") @db.Uuid
  kind                    String
  state                   String    @default("quarantined")
  contentType             String?   @map("content_type")
  uploadKey               String?   @unique @map("upload_key")
  sealedKey               String?   @unique @map("sealed_key")
  uploadSha256            String?   @map("upload_sha256")
  uploadBytes             Int?      @map("upload_bytes")
  uploadExpiresAt         DateTime? @map("upload_expires_at") @db.Timestamptz(6)
  uploadedAt              DateTime? @map("uploaded_at") @db.Timestamptz(6)
  renditionKey            String?   @unique @map("rendition_key")
  posterKey               String?   @unique @map("poster_key")
  scanVerdict             String?   @map("scan_verdict")
  durationSeconds         Float?    @map("duration_seconds")
  sourceWidth             Int?      @map("source_width")
  sourceHeight            Int?      @map("source_height")
  outputWidth             Int?      @map("output_width")
  outputHeight            Int?      @map("output_height")
  moderatedBy             String?   @map("moderated_by") @db.Uuid
  moderatedAt             DateTime? @map("moderated_at") @db.Timestamptz(6)
  moderationNote          String?   @map("moderation_note")
  version                 Int       @default(1)
  captionText             String?   @map("caption_text")
  noSpeechDeclared        Boolean   @default(false) @map("no_speech_declared")
  description             String?
  quarantineReason        String?   @map("quarantine_reason")
  processedAt             DateTime? @map("processed_at") @db.Timestamptz(6)
  rejectedAt              DateTime? @map("rejected_at") @db.Timestamptz(6)
  retentionDueAt          DateTime? @map("retention_due_at") @db.Timestamptz(6)
  retentionPolicy         String?   @map("retention_policy")
  retentionHoldReason     String?   @map("retention_hold_reason")
  retentionDeletedAt      DateTime? @map("retention_deleted_at") @db.Timestamptz(6)
  retentionDeleteAttempts Int       @default(0) @map("retention_delete_attempts")
  retentionNextAttemptAt  DateTime? @map("retention_next_attempt_at") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  listing                 Listing   @relation(fields: [listingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  logoVendors             Vendor[]  @relation("VendorLogoMedia")
  coverVendors            Vendor[]  @relation("VendorCoverMedia")

  @@index([listingId, state])
  @@index([state, retentionDueAt, retentionNextAttemptAt], map: "media_assets_state_retention_due_at_retention_next_attempt_at_i")
  @@index([listingId, kind, state, moderatedAt], map: "media_assets_listing_kind_state_moderated_idx")
  @@map("media_assets")
}

model CatalogImportJob {
  id              String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  vendorId        String             @map("vendor_id") @db.Uuid
  templateVersion String             @map("template_version")
  sourceHash      String             @map("source_hash")
  mode            String
  state           String
  rowCount        Int                @map("row_count")
  validRowCount   Int                @map("valid_row_count")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  committedAt     DateTime?          @map("committed_at") @db.Timestamptz(6)
  vendor          Vendor             @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rows            CatalogImportRow[]

  @@unique([vendorId, sourceHash, mode])
  @@map("catalog_import_jobs")
}

model CatalogImportRow {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  importJobId String           @map("import_job_id") @db.Uuid
  rowNumber   Int              @map("row_number")
  status      String
  errors      Json
  preview     Json?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  importJob   CatalogImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([importJobId, rowNumber])
  @@map("catalog_import_rows")
}

model SearchDocument {
  listingId   String   @id @map("listing_id") @db.Uuid
  kind        String
  title       String
  category    String
  priceCents  Int?     @map("price_cents")
  version     Int
  projectedAt DateTime @default(now()) @map("projected_at") @db.Timestamptz(6)
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([kind, category, title])
  @@index([priceCents, listingId], map: "search_documents_price_listing_idx")
  @@map("search_documents")
}

model Location {
  scheduleCalendar Json? @map("schedule_calendar")
  scheduleVersion Int @default(0) @map("schedule_version")
  goodsOrders               GoodsVendorOrder[]
  goodsHoldLines            GoodsHoldLine[]
  goodsConfiguration        Json?               @map("goods_configuration")
  goodsConfigurationVersion Int                 @default(0) @map("goods_configuration_version")
  id                        String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  vendorId                  String              @map("vendor_id") @db.Uuid
  label                     String?
  city                      String?
  address                   String?
  latitude                  Decimal?            @db.Decimal(9, 6)
  longitude                 Decimal?            @db.Decimal(9, 6)
  vendor                    Vendor              @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventoryMovements        InventoryMovement[]

  @@index([vendorId])
  @@map("locations")
}

model InventoryMovement {
  cancellationLineId String?                @map("cancellation_line_id") @db.Uuid
  cancellationLine   GoodsCancellationLine? @relation(fields: [cancellationLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderLineId        String?                @map("order_line_id") @db.Uuid
  orderLine          GoodsOrderLine?        @relation(fields: [orderLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  holdId             String?                @map("hold_id") @db.Uuid
  hold               GoodsHold?             @relation(fields: [holdId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                 String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  locationId         String                 @map("location_id") @db.Uuid
  listingId          String                 @map("listing_id") @db.Uuid
  sku                String?
  reason             String
  onHandDelta        Int                    @map("on_hand_delta")
  reservedDelta      Int                    @default(0) @map("reserved_delta")
  transferId         String?                @map("transfer_id") @db.Uuid
  note               String?
  actorKind          String                 @map("actor_kind")
  actorId            String                 @map("actor_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  location           Location               @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  listing            Listing                @relation(fields: [listingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([holdId], map: "inventory_movements_hold_id_idx")
  @@index([transferId], map: "inventory_movements_transfer_id_idx")
  @@index([locationId, listingId, sku, createdAt], map: "inventory_movements_location_item_created_idx")
  @@index([listingId, sku, createdAt], map: "inventory_movements_listing_item_created_idx")
  @@map("inventory_movements")
}

model VendorMembership {
  schedulingEnabled Boolean @default(false) @map("scheduling_enabled")
  goodsFulfillmentEnabled Boolean   @default(false) @map("goods_fulfillment_enabled")
  id                      String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  vendorId                String    @map("vendor_id") @db.Uuid
  role                    String
  staffId                 String?   @unique @map("staff_id") @db.Uuid
  locationIds             String[]  @map("location_ids") @db.Uuid
  revokedAt               DateTime? @map("revoked_at") @db.Timestamptz(6)
  user                    User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendor                  Vendor    @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff                   Staff?    @relation(fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, vendorId])
  @@index([vendorId, revokedAt])
  @@map("vendor_memberships")
}

model Staff {
  schedule Json?
  scheduleVersion Int @default(0) @map("schedule_version")
  allocations StaffAllocation[]
  displayName String? @map("display_name")
  profileVersion Int @default(0) @map("profile_version")
  publicConsentAt DateTime? @map("public_consent_at") @db.Timestamptz(6)
  id         String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  vendorId   String            @map("vendor_id") @db.Uuid
  userId     String?           @map("user_id") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  vendor     Vendor            @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       User?             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  membership VendorMembership?

  @@unique([vendorId, userId])
  @@index([userId])
  @@map("staff_members")
}

model IdempotencyRecord {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key         String
  scopeHash   String   @map("scope_hash")
  method      String
  workspaceId String?  @map("workspace_id") @db.Uuid
  requestHash String   @map("request_hash")
  outcome     Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([key, scopeHash, method])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model OutboxEvent {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId     String    @unique @map("event_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  type        String
  payload     Json
  state       String    @default("pending")
  attempts    Int       @default(0)
  claimedBy   String?   @map("claimed_by")
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz(6)
  claimToken  String?   @map("claim_token") @db.Uuid
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  occurredAt  DateTime  @map("occurred_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([state, occurredAt])
  @@index([workspaceId, occurredAt])
  @@index([state, availableAt, claimedAt], map: "outbox_events_claim_idx")
  @@map("outbox_events")
}

model ProviderInboxEvent {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId         String?   @map("workspace_id") @db.Uuid
  provider            String
  providerEventId     String    @map("provider_event_id")
  providerReference   String?   @map("provider_reference")
  payloadHash         String    @map("payload_hash")
  payload             Json
  reconciliationState String    @default("reconciled") @map("reconciliation_state")
  reconciledAt        DateTime? @map("reconciled_at") @db.Timestamptz(6)
  receivedAt          DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt         DateTime? @map("processed_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId])
  @@index([workspaceId, provider, providerReference, reconciliationState], map: "provider_inbox_events_reconciliation_idx")
  @@map("provider_inbox_events")
}

model IdentityVerificationSession {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  provider          String
  providerReference String    @map("provider_reference")
  state             String    @default("issued")
  issuedAt          DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  lastCheckedAt     DateTime? @map("last_checked_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([provider, providerReference])
  @@index([userId, provider, state, issuedAt], map: "identity_verification_sessions_user_state_idx")
  @@index([workspaceId, provider, state, issuedAt], map: "identity_verification_sessions_workspace_state_idx")
  @@map("identity_verification_sessions")
}

model AuditLog {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId   String?  @map("workspace_id") @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String
  correlationId String   @map("correlation_id") @db.Uuid
  metadata      Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

model OutboxReceipt {
  eventId     String   @id @map("event_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@map("outbox_receipts")
}

model GoodsQuote {
  id          String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  customerId  String     @map("customer_id") @db.Uuid
  customer    User       @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaceId String     @map("workspace_id") @db.Uuid
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  selection   Json
  snapshot    Json
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  hold        GoodsHold?

  @@index([customerId, workspaceId, createdAt])
  @@map("goods_quotes")
}

model GoodsHold {
  id          String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  quoteId     String               @unique @map("quote_id") @db.Uuid
  quote       GoodsQuote           @relation(fields: [quoteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  state       String               @default("holding")
  expiresAt   DateTime             @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
